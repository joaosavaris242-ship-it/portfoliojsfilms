/* ---------- PROJECT EDITOR ---------- */
function openProjectEditor(existing){
  const isNew = !existing;
  openModal(`
    <h3>${isNew ? 'Adicionar projeto' : 'Editar projeto'}</h3>
    <div id="modal-msg-area"></div>
    <div class="field"><label>Título</label><input id="f-title" value="${existing ? esc(existing.title) : ''}"></div>
    <div class="field"><label>Descrição</label><textarea id="f-pdesc">${existing ? esc(existing.description||'') : ''}</textarea></div>
    <div class="field">
      <label>Link do vídeo</label>
      <input id="f-video" value="${existing ? esc(existing.videoUrl) : ''}" placeholder="https://youtube.com/watch?v=...">
      <small>Cole um link do YouTube, Vimeo, ou um link direto de arquivo .mp4 hospedado em algum serviço (ex: YouTube não listado, Vimeo, Google Drive público, etc). Não é possível enviar o arquivo de vídeo diretamente por aqui.</small>
    </div>
    <div class="field">
      <label>URL da miniatura (opcional)</label>
      <input id="f-thumb" value="${existing ? esc(existing.thumbnailUrl||'') : ''}">
      <small>Se deixar em branco e o link for do YouTube, a miniatura é gerada automaticamente.</small>
    </div>
    <div class="modal-actions">
      <button class="btn-solid" id="save-proj-btn">${isNew ? 'Adicionar' : 'Salvar'}</button>
    </div>
  `);
  document.getElementById('save-proj-btn').onclick = async () => {
    const title = document.getElementById('f-title').value.trim();
    const description = document.getElementById('f-pdesc').value.trim();
    const videoUrl = document.getElementById('f-video').value.trim();
    const thumbnailUrl = document.getElementById('f-thumb').value.trim();
    const msg = document.getElementById('modal-msg-area');
    if(!title || !videoUrl){ msg.innerHTML = '<div class="modal-error">Preencha ao menos o título e o link do vídeo.</div>'; return; }
    if(isNew){
      projects.unshift({ id: 'p_' + Date.now().toString(36) + Math.random().toString(36).slice(2,7), title, description, videoUrl, thumbnailUrl, createdAt: Date.now() });
    } else {
      const idx = projects.findIndex(p=>p.id === existing.id);
      if(idx > -1) projects[idx] = { ...projects[idx], title, description, videoUrl, thumbnailUrl };
    }
    await saveProjects();
    closeModal();
    render();
  };
}

